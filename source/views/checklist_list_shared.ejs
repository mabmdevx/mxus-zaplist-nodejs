<%- include("layouts/top_auth") %>

<style>
    /* Bootstrap's .table-striped sets background-color directly on <td> for odd rows,
       which overrides a background-color set on the parent <tr>. Target the <td> directly
       (with higher specificity via the row class) so completed rows stay highlighted. */
    .table-striped > tbody > tr.row-completed > td {
        background-color: #d4edda !important;
        color: #256029 !important;
    }

    .sortable-header {
        cursor: pointer;
        user-select: none;
        white-space: nowrap;
    }

    .sortable-header .fa {
        margin-left: 5px;
        color: #999;
    }

    .sortable-header.sort-asc .fa,
    .sortable-header.sort-desc .fa {
        color: #333;
    }

    .star-icon {
        cursor: pointer;
        font-size: 16px;
    }

    .star-icon.fa-star {
        color: #f0ad4e;
    }

    .star-icon.fa-star-o {
        color: #999;
    }
</style>

<div class="row">
    <div class="col-lg-12">
        <h2 class="page-header page-header-title">Checklists Shared With Me</h2>
        <div class="panel panel-default">
            <div class="panel-heading">
                Checklists Shared With Me
            </div>
            <!-- /.panel-heading -->
            <div class="panel-body">

                <ul class="nav nav-tabs" id="checklistFilterTabs" style="margin-bottom: 15px;">
                    <li class="active"><a href="#" data-filter="open">Open</a></li>
                    <li><a href="#" data-filter="completed">Completed</a></li>
                    <li><a href="#" data-filter="starred">Starred</a></li>
                    <li><a href="#" data-filter="public">Public</a></li>
                    <li><a href="#" data-filter="all">All</a></li>
                </ul>

                <div class="table-responsive">

                    <table class="table table-striped table-bordered table-hover" style="margin-bottom:0px;">
                        <thead>
                            <tr>
                                <th class="sortable-header" data-sort="title">Title <i class="fa fa-sort"></i></th>
                                <th class="sortable-header" data-sort="type">Type <i class="fa fa-sort"></i></th>
                                <th class="sortable-header" data-sort="createddate">Created Date <i class="fa fa-sort"></i></th>
                                <th>Star</th>
                                <th class="sortable-header" data-sort="owner">Owner <i class="fa fa-sort"></i></th>
                                <th>Access</th>
                                <th>Is Completed</th>
                                <th>Is Public</th>
                                <th>Update</th>
                                <th>View</th>
                                <th>Share URL</th>
                            </tr>
                        </thead>
                        <tbody id="checklistTableBody">
                            <% if (my_shared_checklists && my_shared_checklists.length) { %>
                                <% my_shared_checklists.forEach(checklist => { %>
                                    <tr class="<%= checklist.checklist_is_completed ? 'row-completed' : '' %>"
                                        data-is-completed="<%= checklist.checklist_is_completed ? 'true' : 'false' %>"
                                        data-is-starred="<%= checklist.checklist_is_starred ? 'true' : 'false' %>"
                                        data-is-public="<%= checklist.checklist_is_public ? 'true' : 'false' %>"
                                        data-sort-title="<%= checklist.checklist_title.toLowerCase() %>"
                                        data-sort-type="<%= checklist.checklist_type.toLowerCase() %>"
                                        data-sort-createddate="<%= checklist.createdAt ? new Date(checklist.createdAt).toISOString() : '' %>"
                                        data-sort-owner="<%= checklist.created_by.user_id.toLowerCase() %>">
                                        <td style="<%= checklist.checklist_is_completed ? 'text-decoration: line-through;' : '' %>">
                                            <%= checklist.checklist_title %>
                                        </td>
                                        <td><%= checklist.checklist_type %></td>
                                        <td><%= checklist.createdAt ? new Date(checklist.createdAt).toLocaleDateString() : '' %></td>
                                        <td class="text-center">
                                            <i class="fa <%= checklist.checklist_is_starred ? 'fa-star' : 'fa-star-o' %> star-icon"
                                               onclick="toggleStar('<%= checklist._id %>', this)"></i>
                                        </td>
                                        <td><%= checklist.created_by.user_id %></td>
                                        <td>
                                            <% 
                                            // Find the access level for the current user
                                            const checklist_user_access_level = checklist.checklist_shared_with.find(user => user.share_user_id && user.share_user_id.user_id);
                                            if (checklist_user_access_level) {
                                            %>
                                            <%= checklist_user_access_level.share_access_level === "RW" ? "Read & Write" : "Read Only" %>
                                            <% } else { %>
                                                N/A
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (checklist && checklist.checklist_is_completed) { %>
                                                <i class="fa fa-check"></i> <!-- Public (check) -->
                                            <% } else { %>
                                                <i class="fa fa-times"></i> <!-- Private (cross) -->
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (checklist && checklist.checklist_is_public) { %>
                                                <i class="fa fa-check"></i> <!-- Public (check) -->
                                            <% } else { %>
                                                <i class="fa fa-times"></i> <!-- Private (cross) -->
                                            <% } %>
                                        </td>
                                        <td>
                                            <a href="/update-checklist/<%= checklist._id %>?source_page=my-shared-checklists" class="btn btn-warning btn-sm">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                        </td>
                                        <td>
                                            <a href="/view-checklist/<%= checklist._id %>" class="btn btn-info btn-sm">
                                                <i class="fa fa-info-circle"></i>
                                            </a>
                                        </td>
                                        <td>
                                            <a href="/share/<%= checklist.checklist_url_slug %>" target="_blank">
                                                <%= checklist.checklist_url_slug %>
                                            </a>
                                            &nbsp;
                                            <div style="float:right;">
                                                <button 
                                                    class="btn btn-sm btn-outline-secondary" 
                                                    onclick="copyToClipboard('<%= checklist.checklist_url_slug %>')">
                                                    Copy
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="11" class="text-center">No checklists have been shared with you.</td>
                                </tr>
                            <% } %>
                            <tr id="emptyFilterRow" style="display:none;">
                                <td colspan="11" class="text-center">No checklists match this filter</td>
                            </tr>

                        </tbody>
                    </table>
                </div>
                <!-- /.table-responsive -->
            </div>
            <!-- /.panel-body -->
        </div>
        <!-- /.panel -->

    </div>
</div>

<script>
    function toggleStar(checklist_id, icon_element) {
        const row = icon_element.closest('tr');
        const new_is_starred = row.dataset.isStarred !== 'true';

        fetch('/api/checklist/toggle-star', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ checklist_id: checklist_id, is_starred: new_is_starred })
        })
        .then(response => response.json())
        .then(() => {
            row.dataset.isStarred = new_is_starred ? 'true' : 'false';
            icon_element.classList.toggle('fa-star', new_is_starred);
            icon_element.classList.toggle('fa-star-o', !new_is_starred);

            // Re-apply the currently active filter in case the Starred tab is active
            const active_filter = document.querySelector('#checklistFilterTabs li.active a').dataset.filter;
            applyFilter(active_filter);
        })
        .catch(err => {
            console.error('Error toggling star:', err);
        });
    }

    function applyFilter(filter) {
        const rows = document.querySelectorAll('#checklistTableBody tr[data-is-completed]');
        let visible_count = 0;

        rows.forEach(row => {
            let show_row = true;

            if (filter === 'open') {
                show_row = row.dataset.isCompleted === 'false';
            } else if (filter === 'completed') {
                show_row = row.dataset.isCompleted === 'true';
            } else if (filter === 'starred') {
                show_row = row.dataset.isStarred === 'true';
            } else if (filter === 'public') {
                show_row = row.dataset.isPublic === 'true';
            }

            row.style.display = show_row ? '' : 'none';
            if (show_row) visible_count++;
        });

        const empty_filter_row = document.getElementById('emptyFilterRow');
        if (empty_filter_row) {
            empty_filter_row.style.display = visible_count === 0 ? '' : 'none';
        }
    }

    document.querySelectorAll('#checklistFilterTabs a').forEach(tab_link => {
        tab_link.addEventListener('click', function (event) {
            event.preventDefault();

            document.querySelectorAll('#checklistFilterTabs li').forEach(li => li.classList.remove('active'));
            this.parentElement.classList.add('active');

            applyFilter(this.dataset.filter);
        });
    });

    // Apply the default active tab's filter on page load
    applyFilter(document.querySelector('#checklistFilterTabs li.active a').dataset.filter);

    // -- Sorting (click column header) --
    const sort_field_map = { title: 'sortTitle', type: 'sortType', createddate: 'sortCreateddate', owner: 'sortOwner' };
    let current_sort_field = null;
    let current_sort_direction = 'asc';

    function sortRows(sort_field, direction) {
        const dataset_key = sort_field_map[sort_field];
        const tbody = document.getElementById('checklistTableBody');
        const rows = Array.from(tbody.querySelectorAll('tr[data-is-completed]'));

        rows.sort((row_a, row_b) => {
            const result = (row_a.dataset[dataset_key] || '').localeCompare(row_b.dataset[dataset_key] || '');
            return direction === 'desc' ? -result : result;
        });
        rows.forEach(row => tbody.appendChild(row));

        // Keep the "no results" row last
        const empty_filter_row = document.getElementById('emptyFilterRow');
        if (empty_filter_row) tbody.appendChild(empty_filter_row);
    }

    document.querySelectorAll('.sortable-header').forEach(header => {
        header.addEventListener('click', function () {
            const sort_field = this.dataset.sort;

            current_sort_direction = (current_sort_field === sort_field && current_sort_direction === 'asc') ? 'desc' : 'asc';
            current_sort_field = sort_field;

            document.querySelectorAll('.sortable-header').forEach(h => {
                h.classList.remove('sort-asc', 'sort-desc');
                h.querySelector('.fa').className = 'fa fa-sort';
            });

            this.classList.add(current_sort_direction === 'asc' ? 'sort-asc' : 'sort-desc');
            this.querySelector('.fa').className = current_sort_direction === 'asc' ? 'fa fa-sort-asc' : 'fa fa-sort-desc';

            sortRows(sort_field, current_sort_direction);
        });
    });
</script>

<%- include("layouts/bottom_auth") %>
