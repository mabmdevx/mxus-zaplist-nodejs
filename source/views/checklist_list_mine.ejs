<%- include("layouts/top_auth") %>

<style>
    /* Bootstrap's .table-striped sets background-color directly on <td> for odd rows,
       which overrides a background-color set on the parent <tr>. Target the <td> directly
       (with higher specificity via the row class) so completed rows stay highlighted. */
    .table-striped > tbody > tr.row-completed > td {
        background-color: #d4edda !important;
        color: #256029 !important;
    }
</style>

<div class="row">
    <div class="col-lg-12">
        <h2 class="page-header page-header-title">My Checklists</h2>
        <div class="panel panel-default">
            <div class="panel-heading">
                My Checklists
            </div>
            <!-- /.panel-heading -->
            <div class="panel-body">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover" style="margin-bottom:0px;">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Type</th>
                                <th>Is Completed</th>
                                <th>Is Shared</th>
                                <th>Is Public</th>
                                <th>Update</th>
                                <th>Delete</th>
                                <th>View</th>
                                <th>Share URL</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (my_checklists && my_checklists.length) { %>
                                <% my_checklists.forEach(checklist => { %>
                                    <tr class="<%= checklist.checklist_is_completed ? 'row-completed' : '' %>">
                                        <td style="<%= checklist.checklist_is_completed ? 'text-decoration: line-through;' : '' %>">
                                            <%= checklist.checklist_title %>
                                        </td>
                                        <td><%= checklist.checklist_type %></td>
                                        <td>
                                            <% if (checklist && checklist.checklist_is_completed) { %>
                                                <i class="fa fa-check"></i> <!-- Public (check) -->
                                            <% } else { %>
                                                <i class="fa fa-times"></i> <!-- Private (cross) -->
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (checklist && checklist.checklist_is_shared) { %>
                                                <i class="fa fa-check"></i> <!-- Public (check) -->
                                            <% } else { %>
                                                <i class="fa fa-times"></i> <!-- Private (cross) -->
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (checklist && checklist.checklist_is_public) { %>
                                                <i class="fa fa-check"></i> <!-- Public (check) -->
                                            <% } else { %>
                                                <i class="fa fa-times"></i> <!-- Private (cross) -->
                                            <% } %>
                                        </td>                                        
                                        <td>
                                            <a href="/update-checklist/<%= checklist._id %>" class="btn btn-warning btn-sm">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                        </td>
                                        <td>
                                            <a href="/delete-checklist/<%= checklist._id %>" class="btn btn-danger btn-sm">
                                                <i class="fa fa-times"></i>
                                            </a>
                                        </td>
                                        <td>
                                            <a href="/view-checklist/<%= checklist._id %>" class="btn btn-info btn-sm">
                                                <i class="fa fa-info-circle"></i>
                                            </a>
                                        </td>
                                        <td>
                                            <a href="/share/<%= checklist.checklist_url_slug %>" target="_blank">
                                                <%= checklist.checklist_url_slug %>
                                            </a>
                                            &nbsp;
                                            <div style="float:right;">
                                                <button 
                                                    class="btn btn-sm btn-outline-secondary" 
                                                    onclick="copyToClipboard('<%= checklist.checklist_url_slug %>')">
                                                    Copy
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="7" class="text-center">No checklists available</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
                <!-- /.table-responsive -->
            </div>
            <!-- /.panel-body -->
        </div>
        <!-- /.panel -->

        <br/>

        <!-- Create New Checklist Button -->
        <div style="float:right;margin-bottom: 20px;">
            <a href="/create-checklist" class="btn btn-success">
                <i class="fa fa-plus"></i> Create New Checklist
            </a>
        </div>

    </div>
</div>

<script>
    function copyToClipboard(slug) {
        const url = `${window.location.origin}/share/${slug}`;
        navigator.clipboard.writeText(url).then(() => {
            //alert("Share URL copied to clipboard: " + url);
        }).catch(err => {
            alert("Failed to copy the URL: " + err);
        });
    }
</script>

<%- include("layouts/bottom_auth") %>
